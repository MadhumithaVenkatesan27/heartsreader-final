# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Needed when deployed behind a proxy such as Render/Nginx (1 = trust first proxy)
TRUST_PROXY=0

# ── Database ──────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/crossed_hearts
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/crossed_hearts
# Docker (docker compose up -d), API running on your computer:
#         mongodb://chadmin:change-me-dev-password@127.0.0.1:27017/crossed_hearts?authSource=admin
MONGO_URI=mongodb://127.0.0.1:27017/crossed_hearts

# ── Auth (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_READ_SECRET=change-me-read-secret-at-least-32-chars
# Set false only for local experiments: skips the email OTP step
REQUIRE_EMAIL_VERIFICATION=true

# ── CORS / URLs ───────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API
FRONTEND_URL=http://127.0.0.1:5502,http://localhost:5502,http://localhost:5500,http://127.0.0.1:5500
# Where the password-reset email link points (defaults to first FRONTEND_URL)
RESET_PASSWORD_URL=
# Cookie settings: use COOKIE_SAMESITE=none when API and site are on different registrable domains
COOKIE_SAMESITE=lax

# ── Email (OTP codes, password reset, support) ────────────
# Leave SMTP_HOST empty in development: emails are printed in the terminal instead.
# Brevo (free plan): brevo.com -> SMTP & API -> SMTP tab
#   SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587
#   SMTP_USER = the "Login" shown on that page (looks like 9a1b2c@smtp-brevo.com)
#   SMTP_PASS = an SMTP KEY you generate there (NOT your Brevo account password)
#   MAIL_FROM must use a sender you have verified in Brevo (Senders & IP -> Senders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Development only. Set true ONLY if you get "self-signed certificate in certificate chain" (antivirus/proxy). Refused in production.
SMTP_TLS_INSECURE=false
MAIL_FROM="Crossed Hearts <no-reply@heartsreader.com>"
SUPPORT_EMAIL=support@heartsreader.com
# Local only, if you get "self-signed certificate in certificate chain" (antivirus/proxy). Ignored in production.
SMTP_TLS_INSECURE=false

# ── Brevo CRM sync (optional, separate from SMTP above) ───
# Brevo -> SMTP & API -> API Keys -> Generate. Every verified reader is added as a contact.
# Lists: Brevo -> Contacts -> Lists; the number is the "ID" column.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_NEWS_LIST_ID=

# ── "Notify me" browser push (npm run vapid prints both keys) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@heartsreader.com

# ── Licensor portal (switched off for now) ────────────────
ENABLE_LICENSOR_PORTAL=false

# ── Payments ──────────────────────────────────────────────
# Stripe (international, USD)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Razorpay (India, INR)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Used only when a title has no explicit INR price
USD_TO_INR=85
# Fake payment providers for local API testing (ignored/refused in production)
MOCK_PAYMENTS=false

# ── Files ─────────────────────────────────────────────────
# Chapter PDFs live here and are only served through authorised endpoints
UPLOADS_DIR=./uploads/private

# ── Seed script (npm run seed) ────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123

# ── Text messages for phone verification (optional; without these the code is printed in the terminal) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
